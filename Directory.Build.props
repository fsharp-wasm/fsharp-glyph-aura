<Project>
  <PropertyGroup>
    <!-- Shared NuGet / build metadata for all projects -->
    <Authors>Glyph-Auro Contributors</Authors>
    <Company>Glyph-Auro</Company>
    <Product>GlyphAura</Product>
    <Copyright>Copyright © 2025 Glyph-Auro Contributors</Copyright>
    <RepositoryUrl>https://github.com/fsharp-wasm/fsharp-glyph-aura</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsAsErrors />
    <Deterministic>true</Deterministic>
    <!-- Enable reproducible builds -->
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>
</Project>
